# =============================================================================
# FlowUp Fraud Detection - Environment Variables
# =============================================================================

# Path to the trained model artifact (joblib)
MODEL_PATH=models/fraud_model.joblib

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Decision threshold for fraud classification (0.0 - 1.0)
# Optimized via Youden's J statistic during training
THRESHOLD=0.5

# Redis connection URL (optional, for caching)
REDIS_URL=redis://redis:6379/0

# Application port
APP_PORT=8000

# Application host
APP_HOST=0.0.0.0

# Model version identifier
MODEL_VERSION=1.0.0
